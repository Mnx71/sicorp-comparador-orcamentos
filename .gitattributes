# Preserve the candidate's extracted whitespace and exact fixture bytes.
src/** whitespace=-blank-at-eol,-blank-at-eof
dist/*.html whitespace=-blank-at-eol
*.csv -text whitespace=cr-at-eol
*.tsv -text whitespace=-blank-at-eol,cr-at-eol
*.txt -text whitespace=cr-at-eol
*.xlsx -text
*.xls -text
*.ORSE -text
